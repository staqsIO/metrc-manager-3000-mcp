METRC_API_URL=https://sandbox-api-co.metrc.com
METRC_VENDOR_API_KEY=
METRC_USER_API_KEY=
# Seed scripts (sandbox) per state
METRC_VENDOR_API_KEY_CO=
METRC_USER_API_KEY_CO=
METRC_VENDOR_API_KEY_MA=
METRC_USER_API_KEY_MA=
# HTTP mode
PORT=8080
# Optional bearer token; when set it protects /mcp and /api/chat
MCP_API_KEY=
# Comma list for browser clients on other origins; empty = same-origin only
ALLOWED_ORIGINS=
# /chat demo (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# Optional key service, e.g. http://keyservice:3001/api/openrouter-key
OPENROUTER_KEY_URL=
# Bearer token for OPENROUTER_KEY_URL
OPENROUTER_KEY_TOKEN=
